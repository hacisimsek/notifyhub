# Copy to secrets.env (git-ignored) and replace every value before applying the manifests.
POSTGRES_USER=notifyhub
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=notifyhub
AUTH_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
RABBITMQ_USERNAME=notifyhub
RABBITMQ_PASSWORD=change-me-rabbitmq-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
# Optional live delivery: only these exact recipients get real EMAIL (Gmail SMTP) or PUSH (ntfy topic); others stay mocked.
NOTIFICATION_LIVE_RECIPIENTS=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
